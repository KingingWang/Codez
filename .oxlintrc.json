{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // 本次上游整合保留既有职责完整的实现；这些文件超 800 行只告警，不机械拆分。
      "files": [
        // 插件市场沿用上游存量大文件，只补充目录字段投影；不为行数机械拆分安装流程。
        "**/apps/codez-cli/packages/adapters/src/plugins/marketplace.ts",
        // MCP 连接入口沿用上游存量实现；连接屏障修复不为行数重排整个 adapter。
        "**/apps/codez-cli/packages/adapters/src/mcp/index.ts",
        "**/apps/codez-cli/packages/bootstrap/src/plugins.ts",
        "**/apps/codez-cli/packages/adapters/src/storage/session-store/migrations.ts",
        "**/apps/codez-cli/packages/adapters/src/storage/session-store/sqlite-session-store.ts",
        "**/apps/codez-cli/packages/bootstrap/src/app/create-app.ts",
        "**/apps/codez-cli/packages/bootstrap/src/app/session-facade.ts",
        "**/apps/codez-cli/packages/bootstrap/src/codez-protocol-v4/v4-gateway.ts",
        "**/apps/codez-cli/packages/bootstrap/src/codez-protocol/server.ts",
        "**/apps/codez-cli/packages/bootstrap/src/codez-protocol/session-mapper.ts",
        "**/apps/codez-cli/packages/bootstrap/src/codez-protocol/v4-bridge.ts",
        "**/apps/codez-cli/packages/contracts/src/interfaces/session-store.port.ts",
        "**/apps/codez-cli/packages/core/src/runtime/methods/steering.ts",
        "**/apps/codez-cli/packages/core/src/runtime/methods/turn.ts",
        "**/apps/codez-cli/packages/core/src/runtime/methods/turn-model-step.ts",
        // core 包内以 --no-ignore 运行时，oxlint 按 cwd 相对路径匹配同一组存量文件。
        "src/runtime/methods/steering.ts",
        "src/runtime/methods/turn.ts",
        "src/runtime/methods/turn-model-step.ts",
        "**/packages/ui/src/remote-connection-flow/index.ts"
      ],
      "rules": {
        "max-lines": ["warn", { "max": 800, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      // 测试文件天然会堆叠大量场景与断言，继续复用生产代码的行数上限会造成误报，
      // 因此只对 test/spec 文件关闭 max-lines，避免放宽业务代码约束。
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/i18n/locales/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".claude/skills",
    ".agents/skills",
    "packages/formal-proof",
    "apps/codez-cli",
    "packages/codez-cua",
    "docs/electron"
  ]
}
