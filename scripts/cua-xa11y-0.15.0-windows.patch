+
+    impl Drop for CodezTestWindow {
+        fn drop(&mut self) {
+            let _ = unsafe { windows::Win32::UI::WindowsAndMessaging::DestroyWindow(self.0) };
+        }
+    }
+
+    #[test]
+    fn codez_win32_discovery_keeps_main_and_owned_windows_without_foreign_pids() {
+        let main = CodezTestWindow::new(true, None);
+        let owned = CodezTestWindow::new(true, Some(main.0));
+        let pid = std::process::id();
+        let found = top_level_hwnds_of_pid(pid).unwrap();
+        assert!(found.contains(&main.0));
+        assert!(found.contains(&owned.0));
+        assert!(found.iter().all(|hwnd| window_pid(*hwnd) == pid));
+        // 不存在的 PID 在 Win32 层即为空，不进入任何 UIA provider。
+        assert!(top_level_hwnds_of_pid(u32::MAX).unwrap().is_empty());
+    }
+
+    #[test]
+    fn codez_win32_discovery_drops_hidden_and_closed_windows() {
+        let hidden = CodezTestWindow::new(false, None);
+        let closed = CodezTestWindow::new(true, None);
+        let closed_hwnd = closed.0;
+        drop(closed);
+        let found = top_level_hwnds_of_pid(std::process::id()).unwrap();
+        assert!(!found.contains(&hidden.0));
+        assert!(!found.contains(&closed_hwnd));
+    }
