+/// Bind a top-level HWND to its owning process without activating any UIA
+/// provider.
+fn window_pid(hwnd: HWND) -> u32 {
+    let mut pid = 0u32;
+    unsafe { GetWindowThreadProcessId(hwnd, Some(&mut pid)) };
+    pid
+}
+
+fn top_level_hwnds_of_pid(pid: u32) -> Result<Vec<HWND>> {
+    // EnumWindows 的 z-order 顺序对应旧 desktop-root UIA 查询；PID 在回调内
+    // 先筛，EnumWindows 自身不是 COM 调用，也不会向无关窗口发送 WM_GETOBJECT。
+    struct State {
+        out: Vec<HWND>,
+        pid: u32,
+        failed_hwnd: Option<HWND>,
+    }
+
+    unsafe extern "system" fn callback(hwnd: HWND, lparam: LPARAM) -> BOOL {
+        let state = unsafe { &mut *(lparam.0 as *mut State) };
+        let candidate_pid = window_pid(hwnd);
+        if candidate_pid != state.pid {
+            return BOOL(1);
+        }
+        if !unsafe { IsWindowVisible(hwnd) }.as_bool() {
+            return BOOL(1);
+        }
+        // FFI 回调不能因容器扩容失败而 unwind。
+        if state.out.try_reserve(1).is_err() {
+            state.failed_hwnd = Some(hwnd);
+            return BOOL(0);
+        }
+        state.out.push(hwnd);
+        BOOL(1)
+    }
+
+    let mut state = State {
+        out: Vec::new(),
+        pid,
+        failed_hwnd: None,
+    };
+    let result = unsafe { EnumWindows(Some(callback), LPARAM(&mut state as *mut State as isize)) };
+    if let Some(hwnd) = state.failed_hwnd {
+        return Err(Error::Platform {
+            code: -1,
+            message: format!(
+                "EnumWindows ran out of memory while collecting windows for pid {pid} at HWND {:?}",
+                hwnd.0
+            ),
+        });
+    }
+    result.map_err(|e| Error::Platform {
+        code: e.code().0 as i64,
+        message: format!("EnumWindows failed for pid {pid}: {e}"),
+    })?;
+    Ok(state.out)
+}
+
+fn window_element_for_pid(
+    autom: &IUIAutomation,
+    cache: Option<&IUIAutomationCacheRequest>,
+    pid: u32,
+    hwnd: HWND,
+) -> Result<Option<IUIAutomationElement>> {
+    // HWND 在 Win32 枚举后可能消失或被其它进程复用；进入 UIA 前再次限定所有者。
+    if window_pid(hwnd) != pid {
+        return Ok(None);
+    }
+    let stage = if cache.is_some() {
+        "windows"
+    } else {
+        "app_by_pid"
+    };
+    let el = uia_call(|| unsafe {
+        match cache {
+            Some(cache) => autom.ElementFromHandleBuildCache(hwnd, cache),
+            None => autom.ElementFromHandle(hwnd),
+        }
+    })
+    .map_err(|e| match e {
+        Error::Platform { code, message } => Error::Platform {
+            code,
+            message: format!(
+                "HWND UIA bind ({stage}) failed for pid {pid} HWND {:?}: {message}",
+                hwnd.0
+            ),
+        },
+        other => other,
+    })?;
+    let current_pid = uia_call(|| unsafe { el.CurrentProcessId() }).map_err(|e| match e {
+        Error::Platform { code, message } => Error::Platform {
+            message: format!(
+                "CurrentProcessId ({stage}) failed for pid {pid} HWND {:?}: {message}",
+                hwnd.0
+            ),
+            code,
+        },
+        other => other,
+    })? as u32;
+    if current_pid != pid || window_pid(hwnd) != pid {
+        return Err(Error::ElementStale {
+            selector: format!("HWND {:?} no longer belongs to pid {pid}", hwnd.0),
+        });
+    }
+    let control_type = uia_call(|| unsafe { el.CurrentControlType() }).map_err(|e| match e {
+        Error::Platform { code, message } => Error::Platform {
+            message: format!(
+                "CurrentControlType ({stage}) failed for pid {pid} HWND {:?}: {message}",
+                hwnd.0
+            ),
+            code,
+        },
+        other => other,
+    })?;
+    if control_type != UIA_WindowControlTypeId {
+        return Ok(None);
+    }
+    Ok(Some(el))
+}
